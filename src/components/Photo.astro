---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt: string;
  class?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const images = import.meta.glob<ImageMetadata>('../assets/images/*.jpg', {
  eager: true,
  import: 'default',
});
const { src, alt, class: className, sizes = '(min-width: 1320px) 584px, (min-width: 1024px) calc((100vw - 152px) / 2), (min-width: 768px) calc((100vw - 120px) / 2), calc(100vw - 40px)', loading = 'lazy' } = Astro.props;
// Keep reviewed photo names and existing callers; originals are now build inputs.
const image = images[src.replace('/images/', '../assets/images/')];
if (!image) throw new Error(`Missing reviewed local image: ${src}`);
const widths = [...new Set([320, 480, 640, 960, 1280, 1600].map(width => Math.min(width, image.width)))];
---
<Image
  src={image}
  width={Math.min(1600, image.width)}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={80}
  alt={alt}
  class={className}
  loading={loading}
  decoding="async"
  fetchpriority={loading === 'eager' ? 'high' : undefined}
/>
