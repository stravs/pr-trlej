---
import Photo from './Photo.astro';
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: string;
  alt?: string;
}
const { eyebrow, title, lead, image, alt } = Astro.props;
---
<section class="border-b border-line">
  <div class:list={['mx-auto grid max-w-[1320px] items-center gap-10 px-5 py-12 sm:px-10 sm:py-16 lg:gap-16 lg:px-14', image ? 'md:grid-cols-[1fr_1fr]' : ''] }>
    <div class="max-w-2xl">
      <p class="eyebrow text-clay">{eyebrow}</p>
      <h1 class="font-display mt-5 text-5xl font-normal leading-[1.06] tracking-[-0.04em] text-ink lg:text-6xl">{title}</h1>
      {lead && <p class="mt-6 max-w-xl text-base leading-7 text-muted">{lead}</p>}
      <span aria-hidden="true" class="font-display mt-6 block text-3xl text-clay">❧</span>
    </div>
    {image && <div>
      <Photo src={`/images/${image}`} alt={alt ?? ''} class="aspect-[4/3] w-full object-cover" sizes="(min-width: 768px) 560px, 100vw" loading="eager" />
    </div>}

  </div>
</section>
