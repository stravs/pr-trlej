---
import LivePrice from './LivePrice.astro';
import type { Quote } from '../lib/pricing';
import Photo from './Photo.astro';
import { priceRange, childrenLabel, type Unit } from '../data/site';
interface Props { units: Unit[]; query?: string; showBuilding?: boolean; quotes?: Record<string, Quote | null> }
const { units, query = '', showBuilding = true, quotes } = Astro.props;
---
{!quotes && <p class="mb-6 max-w-2xl text-xs leading-relaxed text-muted">Indicative room-only prices from saved sample stays. Select dates and guests for live prices.</p>}
<div class="grid gap-5 sm:grid-cols-2 sm:gap-10 lg:grid-cols-3">
  {units.map((unit) => (
            <a href={`/rooms/${unit.slug}/${query ? `?${query}` : ''}`} data-stay-link data-unit-slug={unit.slug} class="group grid grid-cols-[7.5rem_minmax(0,1fr)] items-start gap-4 border-b border-line bg-white pb-5 sm:block sm:pb-0">
              <div class="aspect-[4/5] overflow-hidden sm:aspect-[3/2]">
                <Photo src={`/images/${unit.images[0]}`} alt={unit.name} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" sizes="(min-width: 1320px) 376px, (min-width: 1024px) calc((100vw - 192px) / 3), (min-width: 640px) calc((100vw - 120px) / 2), 120px" loading="lazy" />
              </div>
              <div class="min-w-0 sm:py-6">
                <h3 class="font-display text-xl font-normal leading-snug tracking-tight text-ink sm:text-2xl">{unit.name}</h3>
                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                  {showBuilding && <span class="border border-line px-2 py-0.5 text-xs font-semibold text-muted">
                    {unit.building === 'farm' ? 'Tourist farm' : 'Traditional house'}
                  </span>}
                  <span class:list={['px-2 py-0.5 text-xs font-semibold', unit.bathroom === 'Shared' ? 'bg-clay/15 text-clay-dark' : 'bg-brick/10 text-brick']}>
                    {unit.bathroom} bathroom
                  </span>
                </div>
                <p class="mt-2 text-sm text-muted">{unit.type}{unit.outdoor ? ` · ${unit.outdoor}` : ''}</p>
                <p class="mt-1 text-sm text-ink/90">{[unit.sleeps, unit.beds, childrenLabel(unit.slug)].filter(Boolean).join(' · ')}</p>
                {quotes ? <LivePrice quote={quotes[unit.bentral.unit] ?? null} note={false} /> : <p class="unit-price mt-3 text-base font-bold text-clay-dark">{priceRange(unit.slug)}</p>}
                <p class="mt-1 text-sm font-semibold text-brick group-hover:text-brick-dark">View room →</p>
              </div>
            </a>
  ))}
</div>
