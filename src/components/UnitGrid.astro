---
import LivePrice from './LivePrice.astro';
import type { Quote } from '../lib/pricing';
import Photo from './Photo.astro';
import { priceRange, childrenLabel, type Unit } from '../data/site';
interface Props { units: Unit[]; query?: string; showBuilding?: boolean; quotes?: Record<string, Quote | null> }
const { units, query = '', showBuilding = true, quotes } = Astro.props;
---
{!quotes && <p class="mb-6 max-w-2xl text-xs leading-relaxed text-muted">Indicative room-only prices from saved sample stays. Select dates and guests for live prices.</p>}
<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
  {units.map((unit) => (
            <a href={`/rooms/${unit.slug}/${query ? `?${query}` : ''}`} data-stay-link data-unit-slug={unit.slug} class="group overflow-hidden rounded-none bg-white border-b border-line">
              <div class="aspect-[3/2] overflow-hidden">
                <Photo src={`/images/${unit.images[0]}`} alt={unit.name} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" sizes="(min-width: 1320px) 376px, (min-width: 1024px) calc((100vw - 192px) / 3), (min-width: 640px) calc((100vw - 120px) / 2), calc(100vw - 40px)" loading="lazy" />
              </div>
              <div class="py-6">
                <div class="flex flex-col items-start gap-3">
                  <h3 class="font-display text-2xl font-normal tracking-tight text-ink">{unit.name}</h3>
                  <div class="flex flex-wrap items-center gap-1.5">
                    {showBuilding && <span class="rounded-none border border-line px-2 py-0.5 text-xs font-semibold text-muted">
                      {unit.building === 'farm' ? 'Tourist farm' : 'Traditional house'}
                    </span>}
                    <span class:list={['rounded-none px-2 py-0.5 text-xs font-semibold', unit.bathroom === 'Shared' ? 'bg-clay/15 text-clay-dark' : 'bg-moss/10 text-moss']}>
                      {unit.bathroom} bathroom
                    </span>
                  </div>
                </div>
                <p class="mt-1 text-sm text-muted">{unit.type}{unit.outdoor ? ` · ${unit.outdoor}` : ''}</p>
                <p class="mt-2 text-sm text-ink/90">{unit.sleeps}</p>
                <p class="mt-1 text-sm text-ink/90">{unit.beds}</p>
                <p class="mt-1 text-sm text-ink/90">{childrenLabel(unit.slug)}</p>
                {quotes ? <LivePrice quote={quotes[unit.bentral.unit] ?? null} /> : <p class="unit-price mt-3 text-base font-bold text-clay-dark">{priceRange(unit.slug)}</p>}
                <p class="mt-1 text-sm font-semibold text-moss group-hover:text-moss-dark">View room →</p>
              </div>
            </a>
  ))}
</div>
