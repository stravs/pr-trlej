---
import Photo from './Photo.astro';
import { stays } from '../data/stays';
---
<div class="grid gap-10 md:grid-cols-3">
  {stays.map((stay) => (
    <a href={stay.href} class="group flex flex-col overflow-hidden bg-white border-b border-line">
      <Photo src={`/images/${stay.image}`} alt={stay.alt} sizes="(min-width: 768px) 33vw, 100vw" class="aspect-[3/2] w-full object-cover transition-transform group-hover:scale-[1.02]" />
      <div class="flex flex-1 flex-col py-6">
        <h3 class="font-display text-3xl font-normal tracking-tight text-ink">{stay.name}</h3>
        <p class="mt-2 text-sm font-semibold text-brick">{stay.detail}</p>
        <p class="mb-6 mt-3 text-sm leading-relaxed text-ink/90">{stay.description}</p>
        <p class="mt-auto font-semibold text-brick">{stay.action} →</p>
      </div>
    </a>

  ))}
</div>
