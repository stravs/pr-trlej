---
import { site } from '../data/site';
---
  <footer class="mx-auto max-w-[1320px] px-5 pb-6 pt-14 sm:px-10 lg:px-14"><div class="flex flex-wrap justify-between gap-8"><div><a href="/" aria-label="Pr’ Trlej home" class="text-[#43382e]"><span class="font-display block text-3xl font-bold tracking-tight sm:text-4xl">Pr’ Trlej</span><span class="mt-1 block text-[14px] uppercase tracking-[0.04em]">A Slovenian family welcome</span></a><p class="mt-3 text-sm leading-7 text-[#655544]">{site.address}, {site.city}<br />Slovenia · Under Dobrča, near Bled</p></div><div class="text-sm leading-8"><a class="block hover:underline" href={`mailto:${site.email}`}>{site.email}</a><a class="block hover:underline" href={`tel:${site.phone.replace(/\s/g,'')}`}>{site.phone}</a></div><div class="flex flex-col gap-3 text-sm"><a href="/location/">Find us ↗</a><a href="/policies/">Stay policies</a><a href="/guest-guide/">Guest guide</a></div></div><p class="mt-12 border-t border-[#d9ccba] pt-5 text-[14px] text-[#655544]">Pr’ Trlej · Predogled</p></footer>
