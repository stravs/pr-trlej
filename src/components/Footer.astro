---
import { site } from '../data/site';
---
  <footer class="mx-auto max-w-[1320px] px-5 pb-6 pt-14 sm:px-10 lg:px-14"><div class="flex flex-wrap justify-between gap-8"><div><a href="/" aria-label="Pr’ Trlej home" class="text-[#43382e]"><span class="font-display block text-3xl font-bold tracking-tight sm:text-4xl">Pr’ Trlej</span><span class="mt-1 block text-[14px] uppercase tracking-[0.04em]">A Slovenian family welcome</span></a><p class="mt-3 text-sm leading-7 text-[#655544]">{site.address}, {site.city}<br />Slovenia · Under Dobrča, near Bled</p></div><div class="flex w-full flex-col gap-3 text-sm sm:w-auto"><a class="flex min-h-12 items-center border border-line px-4 font-semibold text-moss hover:bg-sand sm:min-h-0 sm:border-0 sm:px-0 sm:font-normal sm:text-ink sm:hover:bg-transparent sm:hover:underline" href={`tel:${site.phone.replace(/\s/g,'')}`}><span class="sm:hidden">Call&nbsp;</span>{site.phone}</a><a class="flex min-h-12 items-center border border-line px-4 font-semibold text-moss hover:bg-sand sm:min-h-0 sm:border-0 sm:px-0 sm:font-normal sm:text-ink sm:hover:bg-transparent sm:hover:underline" href={`mailto:${site.email}`}><span class="sm:hidden">Email&nbsp;</span>{site.email}</a></div><ul class="w-full text-sm sm:w-auto"><li><a class="flex min-h-11 items-center hover:underline" href="/location/">Find us ↗</a></li><li><a class="flex min-h-11 items-center hover:underline" href="/policies/">Stay policies</a></li><li><a class="flex min-h-11 items-center hover:underline" href="/guest-guide/">Guest guide</a></li></ul></div><p class="mt-12 border-t border-[#d9ccba] pt-5 text-[14px] text-[#655544]">Pr’ Trlej · Predogled</p></footer>
