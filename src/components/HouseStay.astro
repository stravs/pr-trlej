---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingBar from './BookingBar.astro';
import UnitGrid from './UnitGrid.astro';
import { units } from '../data/site';
interface Props { building: 'guesthouse' | 'farm' }
const { building } = Astro.props;
const farm = building === 'farm';
const title = farm ? 'Tourist farm' : 'Traditional house';
const selected = units.filter(unit => unit.building === building);
const params = Astro.url.searchParams;
const search = new URLSearchParams();
for (const key of ['arrival', 'departure', 'adults', 'children']) {
  const value = params.get(key);
  if (value) search.set(key, value);
}
---
<BaseLayout title={title} description={farm ? 'Farm Stay Trlej: single, twin, quadruple and family rooms with shared bathrooms.' : 'Traditional house at Pr’ Trlej: rooms, apartments and suites with private bathrooms.'}>
  <section class="border-b border-line">
    <div class="mx-auto max-w-[1320px] px-5 py-8 sm:px-10 lg:px-14 lg:py-10">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><h1 class="font-display text-4xl tracking-tight sm:text-5xl">{title}</h1><p class="mt-3 leading-7 text-muted">{farm ? 'Simple farm rooms, all with shared bathrooms.' : 'Rooms, apartments and suites, all with private bathrooms.'}</p></div>
        <a href="/accommodation/" class="py-3 text-sm font-semibold text-brick underline underline-offset-4">All accommodation</a>
      </div>
      <div class="mt-6"><BookingBar building={building} arrival={params.get('arrival')} departure={params.get('departure')} adults={params.get('adults') ?? '2'} /></div>
    </div>
  </section>
  <section id="units" class="mx-auto max-w-[1320px] px-5 py-12 sm:px-10 lg:px-14">
    <h2 class="font-display mb-4 text-3xl tracking-tight">{farm ? 'Farm rooms' : 'Rooms, apartments & suites'}</h2>
    <UnitGrid units={selected} query={search.toString()} showBuilding={false} />
    <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-6 text-sm font-semibold text-brick"><a href="/policies/" class="py-2 underline underline-offset-4">Stay policies</a><a href="/farm/" class="py-2 underline underline-offset-4">Farm & food</a><a href="/contact/" class="py-2 underline underline-offset-4">Ask the family</a></div>
  </section>
</BaseLayout>
