---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { stays } from '../data/stays';
---
<BaseLayout>

    <section class="relative isolate overflow-x-clip px-5 pt-6 pb-12 sm:p-0">
      <div class="max-sm:border-gingham mx-auto grid max-w-[1320px] items-center sm:gap-8 sm:px-10 sm:py-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-stretch lg:gap-10 lg:px-14 lg:py-16">
      <div class="relative min-w-0 lg:self-stretch">
        <figure class="sm:border-gingham overflow-hidden lg:absolute lg:inset-0">
          <Photo src="/images/guesthouse-summer.jpg" alt="Flower-filled wooden balconies and the guesthouse surrounded by summer greenery" loading="eager" class="aspect-[4/3] w-full object-cover sm:aspect-[6/5] lg:h-full lg:aspect-auto" sizes="(min-width: 1320px) 622px, (min-width: 1024px) calc((100vw - 152px) * 0.55 - 20px), (min-width: 640px) calc(100vw - 100px), calc(100vw - 60px)" />
        </figure>
      </div>
      <div class="sm:border-gingham relative p-5 sm:px-8 sm:py-10 lg:px-9 lg:py-11">
        <p class="flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.1em] text-clay sm:text-[14px] sm:tracking-[0.16em]"><span aria-hidden="true" class="hidden h-px w-7 shrink-0 bg-clay/60 sm:block"></span><span>Good food. Fresh air.<br class="sm:hidden" /> A warm welcome.</span></p>
        <h1 class="font-display mt-5 text-[clamp(2.75rem,4.8vw,4.5rem)] leading-[1.06] tracking-[-0.045em]">A little farm.<br />A big <span class="italic text-[#b4222a]">welcome.</span></h1>
        <p class="mt-6 max-w-sm text-base leading-7 text-[#5f5043]">Come for the mountains. Stay for the homemade breakfast, the slower mornings, and the feeling of being right at home.</p>
        <a href="/accommodation/" class="mt-7 inline-flex min-h-12 items-center gap-4 bg-brick px-4 py-3.5 text-sm font-semibold text-cream transition-colors hover:bg-brick-dark">Book now <span aria-hidden="true">↗</span></a>
        <div class="mt-7 flex items-center gap-3 border-t border-line pt-5"><span aria-hidden="true" class="font-display text-3xl text-clay">❧</span><p class="text-xs leading-7">Hosted by Ana, Toni & Špela<br /><span class="text-[#655544]">Under Dobrča, near Bled.</span></p></div>
      </div>
      </div>
    </section>
    <section aria-label="Stay highlights" class="border-y border-line bg-white px-5 py-2 text-ink sm:px-10 lg:px-14">
      <ul class="mx-auto grid max-w-[1208px] grid-cols-2 border-ink/15 lg:grid-cols-4">
        {[
          { title: 'Homemade', detail: 'Breakfasts' },
          { title: 'Farm animals', detail: 'Ponies & horses' },
          { title: 'Three ways', detail: 'To stay' },
          { title: '12 km', detail: 'From Bled' },
        ].map((item, index) => (
          <li class:list={[
            'flex flex-col items-center justify-center gap-3 border-ink/15 px-3 py-6 text-center lg:my-5 lg:py-2',
            index % 2 === 0 && 'border-r',
            index < 2 && 'border-b lg:border-b-0',
            index === 1 && 'lg:border-r',
          ]}>
            <span class="font-display text-[27px] leading-none tracking-tight sm:text-[32px]">{item.title}</span>
            <span class="text-[14px] font-medium uppercase leading-7 tracking-[0.08em] text-muted sm:text-[14px]">{item.detail}</span>
          </li>
        ))}
      </ul>
    </section>
    <section id="stays" class="mx-auto max-w-[1320px] scroll-mt-6 px-5 py-20 sm:px-10 lg:px-14">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-5"><div><p class="text-[14px] font-semibold uppercase tracking-[0.1em] text-[#b4222a]">Unpack. Settle in. Stay a while.</p><h2 class="font-display mt-3 text-4xl tracking-tight sm:text-5xl">Find your kind of cosy.</h2></div><p class="max-w-xs text-sm leading-7 text-[#655544]">A room in the house, a simple farm stay, or a night beneath the stars.</p></div>
      <div class="grid gap-10 md:grid-cols-3">{stays.map((stay) => <a href={stay.href} class="group block border-b border-[#d9ccba] pb-6"><div class="overflow-hidden"><Photo src={`/images/${stay.image}`} alt={stay.alt} class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" sizes="(min-width: 1320px) 376px, (min-width: 1024px) calc((100vw - 192px) / 3), (min-width: 768px) calc((100vw - 160px) / 3), (min-width: 640px) calc(100vw - 80px), calc(100vw - 40px)" /></div><div class="mt-5 flex items-start justify-between gap-4"><h3 class="font-display text-3xl tracking-tight">{stay.name}</h3></div><p class="mt-3 min-h-10 text-xs font-semibold leading-7 text-[#8b302d]">{stay.detail}</p><p class="mt-3 text-sm leading-7 text-[#655544]">{stay.description}</p><span class="mt-5 inline-block text-sm font-semibold text-[#8b302d] underline-offset-4 group-hover:underline">{stay.action} ↗</span></a>)}</div>
    </section>
    <section id="farm" class="scroll-mt-6 bg-sand py-16 sm:py-24">
      <div class="mx-auto grid max-w-[1320px] items-center gap-12 px-5 sm:px-10 md:grid-cols-2 lg:gap-24 lg:px-14">
        <div class="grid gap-4"><Photo src="/images/farm-horses.jpg" alt="Horses grazing together in the meadow at the farm" class="aspect-[5/4] w-full object-cover" /><figure><Photo src="/images/farm-breakfast-pastries.jpg" alt="Fresh breakfast pastries on a red gingham tablecloth" class="aspect-[16/7] w-full object-cover" /></figure></div>
        <div><p class="text-[14px] font-semibold uppercase tracking-[0.1em] text-[#b4222a]">From our family to yours</p><h2 class="font-display mt-4 text-4xl leading-[1.1] tracking-tight sm:text-5xl">Nothing fancy.<br /><span class="italic text-[#b4222a]">Just a little special.</span></h2><p class="mt-6 text-sm leading-7 text-[#5f5043]">This is our home, and a working family farm. There are animals to meet, meadows to wander, and breakfast made with ingredients grown right here.</p><p class="mt-4 text-sm leading-7 text-[#5f5043]">We’re Ana, Toni and Špela. Whether you’re arriving with muddy boots, little ones or a motorcycle, we’ll help you feel at home.</p><a href="/farm/" class="mt-7 inline-block border-b border-[#8b302d] pb-2 text-sm font-semibold text-[#8b302d]">A taste of life here ↗</a><p class="font-display mt-7 text-2xl italic text-[#b4222a]">Se vidimo! <span class="font-body ml-2 text-xs not-italic text-[#655544]">See you soon.</span></p></div>
      </div>
    </section>
    <section id="explore" class="mx-auto max-w-[1320px] scroll-mt-6 px-5 py-20 sm:px-10 lg:px-14"><div class="mb-9 flex flex-wrap items-end justify-between gap-5"><div><p class="text-[14px] font-semibold uppercase tracking-[0.1em] text-[#b4222a]">A little further afield</p><h2 class="font-display mt-3 text-4xl tracking-tight sm:text-5xl">Slow days. Open roads.</h2></div><a href="/activities/" class="text-sm font-semibold text-[#8b302d]">Explore the area ↗</a></div><div class="grid gap-8 md:grid-cols-2"><a href="/location/" class="group flex h-full flex-col"><Photo src="/images/area-lake-bled.jpg" alt="Lake Bled with its island church, seen from the water’s edge" class="aspect-[16/9] w-full shrink-0 object-cover" /><h3 class="font-display mt-5 text-2xl">Mountains on the doorstep. Bled down the road.</h3><p class="mt-2 text-sm leading-7 text-[#655544]">Head out for a hike or a day by the lake. Come home to the countryside.</p></a><a href="/motorcycles/" class="group flex h-full flex-col"><Photo src="/images/spela.jpg" alt="Motorcyclists visiting the guesthouse" class="aspect-[16/9] w-full shrink-0 object-cover" /><h3 class="font-display mt-5 text-2xl">Two wheels. A very warm welcome.</h3><p class="mt-2 text-sm leading-7 text-[#655544]">Covered motorcycle parking, tools, and a few favourite routes from Toni.</p></a></div></section>
    <section class="border-y border-line bg-white px-5 py-16 sm:px-10 sm:py-20"><div class="mx-auto max-w-3xl text-center"><h2 class="font-display text-4xl tracking-tight sm:text-5xl">There’s a place for you here.</h2><p class="mx-auto mt-5 max-w-md text-sm leading-7 text-[#655544]">Choose your stay, or tell us a little about your plans. We’ll help you find the right spot.</p><div class="mt-7 flex flex-wrap justify-center gap-5"><a href="#stays" class="bg-[#8b302d] px-6 py-3 text-sm font-semibold text-[#fff9ef] hover:bg-[#672421]">Find your stay ↗</a><a href="/contact/" class="border-b border-[#8b302d] px-2 py-3 text-sm font-semibold text-[#8b302d]">Ask the family</a></div></div></section>

</BaseLayout>
