---
import '../styles/global.css';
import Photo from '../components/Photo.astro';
import { stays } from '../data/stays';
import { site } from '../data/site';
const nav = [{href:'#stays',label:'Stay with us'},{href:'#farm',label:'Life on the farm'},{href:'#explore',label:'Around here'}];
const gingham = 'bg-[linear-gradient(90deg,rgba(139,48,45,0.12)_50%,transparent_50%),linear-gradient(rgba(139,48,45,0.12)_50%,transparent_50%)] bg-[size:20px_20px]';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Welcome to our family farm · Pr’ Trlej</title>
  <meta name="description" content="A family welcome under Dobrča. Discover the traditional house, farm rooms and Camp Starshine at Pr’ Trlej." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="bg-[#f7f1e5] text-[#43382e] antialiased selection:bg-[#8b302d] selection:text-white [&_:is(a,summary):focus-visible]:outline-2 [&_:is(a,summary):focus-visible]:outline-offset-4 [&_:is(a,summary):focus-visible]:outline-[#8b302d] motion-reduce:[&_*]:!scroll-auto motion-reduce:[&_*]:!transition-none">
  <a href="#main" class="fixed left-4 top-4 z-50 -translate-y-32 bg-[#8b302d] p-4 text-white focus:translate-y-0">Skip to content</a>
  <div class="border-b border-[#8b302d]/15 px-4 py-2 text-center text-[10px] font-semibold uppercase tracking-[0.2em] sm:text-xs">A family farm under Dobrča &nbsp; · &nbsp; Begunje, Slovenia</div>
  <header class="relative z-20 mx-auto flex max-w-[1320px] items-center justify-between gap-6 px-5 py-5 sm:px-10 lg:px-14">
    <a href="/prototype-farmhouse/" aria-label="Pr’ Trlej prototype home" class="text-[#8b302d]"><span class="font-display block text-3xl font-bold tracking-tight sm:text-4xl">Pr’ Trlej</span><span class="mt-1 block text-[9px] uppercase tracking-[0.24em]">A Slovenian family welcome</span></a>
    <nav aria-label="Main" class="hidden items-center gap-8 text-sm md:flex">{nav.map(item => <a class="underline-offset-8 hover:underline" href={item.href}>{item.label}</a>)}</nav>
    <a href="#stays" class="hidden border border-[#8b302d] bg-[#8b302d] px-5 py-3 text-sm font-semibold text-[#fff9ef] transition-colors hover:bg-[#672421] sm:block">Find your stay ↗</a>
    <details class="relative sm:hidden"><summary class="cursor-pointer py-3 text-sm font-semibold">Menu</summary><nav aria-label="Mobile" class="absolute right-0 top-full w-56 border border-[#d9ccba] bg-[#f7f1e5] p-4 shadow-lg">{nav.map(item => <a class="block py-3" href={item.href}>{item.label}</a>)}</nav></details>
  </header>
  <main id="main">
    <section class="mx-auto grid max-w-[1320px] items-center gap-10 px-5 pb-16 pt-7 sm:px-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14 lg:px-14 lg:pb-24 lg:pt-10">
      <div class="lg:pb-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#8b302d]">Good food. Fresh air. A warm welcome.</p>
        <h1 class="font-display mt-6 text-[clamp(3.25rem,5.5vw,5.5rem)] leading-[1.03] tracking-[-0.045em]">A little farm.<br />A big <span class="italic text-[#8b302d]">welcome.</span></h1>
        <p class="mt-7 max-w-sm text-base leading-7 text-[#6b5b4c]">Come for the mountains. Stay for the homemade breakfast, the slower mornings, and the feeling of being right at home.</p>
        <a href="#stays" class="mt-8 inline-flex items-center gap-9 bg-[#8b302d] px-6 py-4 text-sm font-semibold text-[#fff9ef] hover:bg-[#672421]">Make yourself at home <span aria-hidden="true">↗</span></a>
        <div class="mt-9 flex items-center gap-4"><span aria-hidden="true" class="font-display text-4xl text-[#8b302d]">❧</span><p class="text-xs leading-5">Hosted by Ana, Toni & Špela<br /><span class="text-[#786858]">Under Dobrča, near Bled.</span></p></div>
      </div>
      <div class="relative pb-9 pl-3 sm:pl-6">
        <div aria-hidden="true" class:list={['absolute inset-y-5 -left-1 right-5',gingham]}></div>
        <figure class="relative rotate-[1deg] bg-[#fffcf5] p-2 pb-4 shadow-[0_8px_30px_#43382e12] sm:p-3 sm:pb-5">
          <Photo src="/images/1-1.jpg" alt="Wooden balconies, flower boxes and the sunny terrace at Pr’ Trlej" loading="eager" class="aspect-[6/5] w-full object-cover" sizes="(min-width: 1024px) 620px, 100vw" />
          <figcaption class="font-display pt-4 text-center text-sm italic text-[#786858]">Our little corner of Gorenjska.</figcaption>
        </figure>
        <div class="absolute -bottom-2 right-0 flex size-28 -rotate-12 flex-col items-center justify-center rounded-full border border-dashed border-[#f7f1e5]/60 bg-[#8b302d] text-center text-[#fff9ef] outline-4 outline-[#8b302d] sm:right-4"><span class="mt-1 text-[10px] uppercase leading-4 tracking-[0.15em]">Fresh air<br />comes included</span></div>
      </div>
    </section>
    <div class="border-y border-[#d9ccba] px-5 py-5"><div class="mx-auto flex max-w-5xl flex-wrap justify-center gap-x-10 gap-y-3 text-xs text-[#6b5b4c]"><span>Homemade breakfasts</span><span>Animals & meadow days</span><span>Three ways to stay</span><span>12 km from Bled</span></div></div>
    <section id="stays" class="mx-auto max-w-[1320px] scroll-mt-6 px-5 py-20 sm:px-10 lg:px-14">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-5"><div><p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#8b302d]">Unpack. Settle in. Stay a while.</p><h2 class="font-display mt-3 text-4xl tracking-tight sm:text-5xl">Find your kind of cosy.</h2></div><p class="max-w-xs text-sm leading-6 text-[#786858]">A room in the house, a simple farm stay, or a night beneath the stars.</p></div>
      <div class="grid gap-10 md:grid-cols-3">{stays.map((stay,index) => <a href={stay.href} class="group block border-b border-[#d9ccba] pb-6"><div class="overflow-hidden"><Photo src={`/images/${stay.image}`} alt={stay.alt} class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" sizes="(min-width: 768px) 380px, 100vw" /></div><div class="mt-5 flex items-start justify-between gap-4"><h3 class="font-display text-3xl tracking-tight">{stay.name}</h3><span class="pt-1 text-xs text-[#8b302d]">0{index+1}</span></div><p class="mt-3 min-h-10 text-xs font-semibold leading-5 text-[#8b302d]">{stay.detail}</p><p class="mt-3 text-sm leading-6 text-[#786858]">{stay.description}</p><span class="mt-5 inline-block text-sm font-semibold text-[#8b302d] underline-offset-4 group-hover:underline">{stay.action} ↗</span></a>)}</div>
    </section>
    <section id="farm" class="scroll-mt-6 bg-[#ede4d4] py-16 sm:py-24">
      <div class="mx-auto grid max-w-[1320px] items-center gap-12 px-5 sm:px-10 md:grid-cols-2 lg:gap-24 lg:px-14">
        <div class="relative pb-12 pr-12"><Photo src="/images/20231001_121558.jpg" alt="Horse and rider in a green meadow at the farm" class="aspect-[5/4] w-full object-cover" /><figure class="absolute bottom-0 right-0 w-[47%] rotate-[-5deg] bg-[#fffcf5] p-2 pb-3 shadow-md"><Photo src="/images/DSC1301-HDR.jpg" alt="Homemade breakfast in the wood-panelled dining room" class="aspect-[4/3] w-full object-cover" /><figcaption class="font-display mt-2 text-center text-xs italic">Breakfast, the farmhouse way.</figcaption></figure></div>
        <div><p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#8b302d]">From our family to yours</p><h2 class="font-display mt-4 text-4xl leading-[1.1] tracking-tight sm:text-5xl">Nothing fancy.<br /><span class="italic text-[#8b302d]">Just a little special.</span></h2><p class="mt-6 text-sm leading-7 text-[#6b5b4c]">This is our home, and a working family farm. There are animals to meet, meadows to wander, and breakfast made with ingredients grown right here.</p><p class="mt-4 text-sm leading-7 text-[#6b5b4c]">We’re Ana, Toni and Špela. Whether you’re arriving with muddy boots, little ones or a motorcycle, we’ll help you feel at home.</p><a href="/farm/" class="mt-7 inline-block border-b border-[#8b302d] pb-2 text-sm font-semibold text-[#8b302d]">A taste of life here ↗</a><p class="font-display mt-7 text-2xl italic text-[#8b302d]">Se vidimo! <span class="font-body ml-2 text-xs not-italic text-[#786858]">See you soon.</span></p></div>
      </div>
    </section>
    <section id="explore" class="mx-auto max-w-[1320px] scroll-mt-6 px-5 py-20 sm:px-10 lg:px-14"><div class="mb-9 flex flex-wrap items-end justify-between gap-5"><div><p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#8b302d]">A little further afield</p><h2 class="font-display mt-3 text-4xl tracking-tight sm:text-5xl">Slow days. Open roads.</h2></div><a href="/activities/" class="text-sm font-semibold text-[#8b302d]">Explore the area ↗</a></div><div class="grid gap-8 md:grid-cols-[1.2fr_1fr]"><a href="/location/" class="group"><Photo src="/images/dobleda.jpg" alt="Lake Bled with its island church and castle" class="aspect-[16/9] w-full object-cover" /><h3 class="font-display mt-5 text-2xl">Mountains on the doorstep. Bled down the road.</h3><p class="mt-2 text-sm leading-6 text-[#786858]">Head out for a hike or a day by the lake. Come home to the countryside.</p></a><a href="/motorcycles/" class="group"><Photo src="/images/spela.jpg" alt="Motorcyclists visiting the guesthouse" class="aspect-[16/9] w-full object-cover" /><h3 class="font-display mt-5 text-2xl">Two wheels. A very warm welcome.</h3><p class="mt-2 text-sm leading-6 text-[#786858]">Covered motorcycle parking, tools, and a few favourite routes from Toni.</p></a></div></section>
    <section class:list={['px-5 py-12 sm:px-10',gingham]}><div class="mx-auto max-w-3xl bg-[#f7f1e5] px-6 py-12 text-center sm:px-12"><h2 class="font-display mt-4 text-4xl tracking-tight sm:text-5xl">There’s a place for you here.</h2><p class="mx-auto mt-5 max-w-md text-sm leading-6 text-[#786858]">Choose your stay, or tell us a little about your plans. We’ll help you find the right spot.</p><div class="mt-7 flex flex-wrap justify-center gap-5"><a href="#stays" class="bg-[#8b302d] px-6 py-3 text-sm font-semibold text-[#fff9ef] hover:bg-[#672421]">Find your stay ↗</a><a href="/contact/" class="border-b border-[#8b302d] px-2 py-3 text-sm font-semibold text-[#8b302d]">Ask the family</a></div></div></section>
  </main>
  <footer class="mx-auto max-w-[1320px] px-5 pb-6 pt-14 sm:px-10 lg:px-14"><div class="flex flex-wrap justify-between gap-8"><div><p class="font-display text-3xl font-bold text-[#8b302d]">Pr’ Trlej</p><p class="mt-3 text-sm leading-6 text-[#786858]">{site.address}, {site.city}<br />Slovenia · Under Dobrča, near Bled</p></div><div class="text-sm leading-8"><a class="block hover:underline" href={`mailto:${site.email}`}>{site.email}</a><a class="block hover:underline" href={`tel:${site.phone.replace(/\s/g,'')}`}>{site.phone}</a></div><div class="flex flex-col gap-3 text-sm"><a href="/location/">Find us ↗</a><a href="/policies/">Stay policies</a><a href="/">Compare original design ↗</a></div></div><p class="mt-12 border-t border-[#d9ccba] pt-5 text-[11px] text-[#786858]">Pr’ Trlej · Farmhouse design prototype · Predogled</p></footer>
</body>
</html>
