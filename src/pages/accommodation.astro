---
import LivePrice from '../components/LivePrice.astro';
import { loadQuote, type Quote } from '../lib/pricing';
import { loadCalendar, matchingUnits, validSearch } from '../lib/availability';
import BaseLayout from '../layouts/BaseLayout.astro';
import UnitGrid from '../components/UnitGrid.astro';
import { stays } from '../data/stays';
import Photo from '../components/Photo.astro';
import BookingBar from '../components/BookingBar.astro';
import { formatStay, plural } from '../lib/dates';
import { buildings, units, campingPitches, bentralBookingUrl, type Building } from '../data/site';

export const prerender = false;

const requested = Astro.url.searchParams.get('building');
const validBuilding = requested === 'farm' || requested === 'guesthouse' || requested === 'camping';
const building = validBuilding ? requested as Building : undefined;
const arrival = Astro.url.searchParams.get('arrival');
const departure = Astro.url.searchParams.get('departure');
const adults = Astro.url.searchParams.get('adults') ?? '2';
const children = Astro.url.searchParams.get('children') ?? '0';
const search = { arrival: arrival ?? '', departure: departure ?? '', adults: Number(adults), children: Number(children) };
const searched = arrival !== null || departure !== null;
const searchValid = validSearch(search);
const searchBuildings = validBuilding ? [requested as Building] : (Object.keys(buildings) as Building[]);
const results = searched && searchValid ? await Promise.all(searchBuildings.map(async (property) => {
  try {
    const calendar = await loadCalendar(bentralBookingUrl(property));
    const matches = matchingUnits(calendar, search);
    const quotes: Record<string, Quote | null> = Object.fromEntries(await Promise.all(matches.map(async unit => [unit.id, await loadQuote(buildings[property], unit.id, search)])));
    return { property, matches, quotes, failed: false };
  } catch {
    return { property, matches: [], quotes: {} as Record<string, Quote | null>, failed: true };
  }
})) : [];
const query = new URLSearchParams({ arrival: arrival ?? '', departure: departure ?? '', adults, children }).toString();
const matchCount = results.reduce((count, result) => count + result.matches.length, 0);
// Same compact phone layout as UnitGrid cards.
const pitchGrid = 'grid gap-5 sm:grid-cols-2 sm:gap-10 lg:grid-cols-3';
const pitchCard = 'group grid grid-cols-[7.5rem_minmax(0,1fr)] items-start gap-4 border-b border-line bg-white pb-5 sm:block sm:pb-0';
const pitchPhoto = 'aspect-[4/5] w-full object-cover sm:aspect-[3/2]';
const pitchSizes = '(min-width: 1024px) calc((100vw - 192px) / 3), (min-width: 640px) calc((100vw - 120px) / 2), 120px';
const propertyName = (property: Building) => stays.find(stay => stay.building === property)?.name;
const jumpLinks = searched ? results.filter(result => result.matches.length > 0).map(result => ({ property: result.property, count: result.matches.length })) : searchBuildings.map(property => ({ property, count: property === 'camping' ? campingPitches.length : units.filter(unit => unit.building === property).length }));
---
<BaseLayout title="Accommodation & booking" description="Choose and book the traditional house, tourist farm rooms or Camp Starshine camping at Pr’ Trlej near Bled.">
  <section data-accommodation-hero class="border-b border-line bg-white [--booking-half:220px] sm:[--booking-half:190px] xl:[--booking-half:90px]">
    <div class="relative isolate overflow-hidden bg-brick">
      <Photo src="/images/guesthouse-summer.jpg" alt="Pr’ Trlej guesthouse with flower-filled wooden balconies and summer greenery" class="absolute inset-0 -z-20 h-full w-full object-cover object-[65%_45%]" sizes="100vw" loading="eager" />
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/70 sm:bg-transparent sm:bg-linear-to-r sm:from-black/75 sm:via-black/45 sm:to-black/10"></div>
      <div class="mx-auto flex min-h-[340px] max-w-[1320px] items-end px-5 pt-12 pb-[calc(var(--booking-half)+3rem)] sm:min-h-[420px] sm:px-10 sm:pt-16 sm:pb-[calc(var(--booking-half)+4rem)] lg:min-h-[460px] lg:px-14">
        <div class="max-w-xl text-cream">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cream/90">Stay with us · Near Bled</p>
          <h1 class="font-display mt-4 text-5xl leading-[1.06] tracking-tight sm:text-6xl lg:text-7xl">Find your stay.</h1>
          <p class="mt-5 max-w-md text-base leading-7 text-cream/95 sm:text-lg">A cosy room, space for the family, or a pitch under the stars. Make yourself at home at Pr’ Trlej.</p>
        </div>
      </div>
    </div>
    <div class="relative z-10 mx-auto -mt-[var(--booking-half)] w-full max-w-[1320px] px-5 pb-8 sm:px-10 lg:px-14">
      <BookingBar selectProperty building={building} arrival={arrival} departure={departure} adults={adults} />
    </div>
  </section>
  {searched && <section id="booking" class="mx-auto max-w-[1320px] px-5 py-12 sm:px-10 lg:px-14" aria-label="Availability results" aria-live="polite">
    <h2 class="font-display text-3xl tracking-tight">Available units</h2>
    {!searchValid ? <p class="mt-4">Enter valid dates, a check-out after check-in, and valid guest counts.</p> : <>
      <p class="mt-3 font-semibold">{formatStay(search.arrival, search.departure)} · {plural(search.adults, 'adult', 'adults')}{search.children > 0 && ` · ${plural(search.children, 'child', 'children')}`} · {plural(matchCount, 'unit', 'units')} available</p>
      <p class="mt-2 max-w-2xl text-xs leading-relaxed text-muted">Nightly rate is accommodation only. Total includes quoted mandatory charges. Optional extras and payment fees may apply. Final rates, stay restrictions and children’s ages are confirmed by Bentral.</p>
      {jumpLinks.length > 1 && <nav aria-label="Jump to property" class="mt-6 flex flex-wrap gap-2">{jumpLinks.map(link => <a href={`#units-${link.property}`} class="flex min-h-11 items-center border border-line px-4 text-sm font-semibold text-brick hover:bg-sand">{propertyName(link.property)} ({link.count})</a>)}</nav>}
      {matchCount === 0 && results.every(result => !result.failed) && <p class="mt-6">No units match these dates and guests. Try different dates or contact us for a stay across multiple units.</p>}
      {results.map(({ property, matches, quotes, failed }) => <section data-property={property} aria-labelledby={`units-${property}`} class="mt-12 border-t border-line pt-8">
        <h3 id={`units-${property}`} class="font-display mb-6 text-3xl">{propertyName(property)}</h3>
        {failed ? <p>Availability could not be checked. Please try again or <a href="/contact/" class="text-brick underline">contact us</a>.</p> : matches.length === 0 ? <p class="text-muted">No matching units.</p> : <>
          {property !== 'camping' && <UnitGrid units={units.filter(unit => unit.building === property && matches.some(match => match.id === unit.bentral.unit))} query={query} quotes={quotes} showBuilding={false} />}
          {property === 'camping' && <div class={pitchGrid}>
            {campingPitches.filter(pitch => matches.some(match => match.id === pitch.unit)).map(pitch => <a href={`/camping/${pitch.slug}/?${query}`} class={pitchCard}>
              <Photo src={pitch.slug === 'tent' ? '/images/camp-sunset.jpg' : '/images/camp-valley.jpg'} alt={pitch.name} class={pitchPhoto} sizes={pitchSizes} />
              <div class="min-w-0 sm:py-6"><h4 class="font-display text-xl sm:text-2xl">{pitch.name}</h4><LivePrice quote={quotes[pitch.unit] ?? null} note={false} /><p class="mt-3 text-sm font-semibold text-brick">View pitch →</p></div>
            </a>)}
          </div>}
        </>}
      </section>)}
    </>}
  </section>}
  {!searched && <section class="mx-auto max-w-[1320px] px-5 py-12 sm:px-10 lg:px-14">
    <nav aria-label="Jump to property" class="flex flex-wrap gap-2">{jumpLinks.map(link => <a href={`#units-${link.property}`} class="flex min-h-11 items-center border border-line px-4 text-sm font-semibold text-brick hover:bg-sand">{propertyName(link.property)} ({link.count})</a>)}</nav>
    {searchBuildings.map(property => <section data-property={property} aria-labelledby={`units-${property}`} class="mt-12 border-t border-line pt-8">
      <h2 id={`units-${property}`} class="font-display mb-6 text-3xl">{propertyName(property)}</h2>
      {property !== 'camping' ? <UnitGrid units={units.filter(unit => unit.building === property)} showBuilding={false} /> : <div class={pitchGrid}>
        {campingPitches.map(pitch => <a href={`/camping/${pitch.slug}/`} class={pitchCard}>
          <Photo src={pitch.slug === 'tent' ? '/images/camp-sunset.jpg' : '/images/camp-valley.jpg'} alt={pitch.name} class={pitchPhoto} sizes={pitchSizes} />
          <div class="min-w-0 sm:py-6"><h3 class="font-display text-xl sm:text-2xl">{pitch.name}</h3><p class="mt-3 text-sm font-semibold text-brick">View pitch →</p></div>
        </a>)}
      </div>}
    </section>)}
  </section>}
  <script>
    const hero = document.querySelector<HTMLElement>('[data-accommodation-hero]');
    const bar = hero?.querySelector<HTMLElement>('#booking-bar');
    if (hero && bar) {
      const updateOverlap = () => {
        hero.style.setProperty('--booking-half', `${bar.getBoundingClientRect().height / 2}px`);
      };
      updateOverlap();
      new ResizeObserver(updateOverlap).observe(bar);
    }
  </script>
</BaseLayout>
