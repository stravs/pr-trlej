---
import { loadUnitStay } from '../../lib/unit-stay';
import LivePrice from '../../components/LivePrice.astro';
import UnitBooking from '../../components/UnitBooking.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import { units, priceRange, childrenLabel } from '../../data/site';

export const prerender = false;
const unit = units.find(candidate => candidate.slug === Astro.params.slug);
if (!unit) return new Response('Unit not found', { status: 404 });

const stay = await loadUnitStay(unit.building, unit.bentral.unit, Astro.url.searchParams);

const facts = [
  { label: 'Building', value: unit.building === 'farm' ? 'Tourist farm' : 'Traditional house' },
  { label: 'Type', value: unit.type },
  { label: 'Bathroom', value: unit.bathroom },
  ...(unit.outdoor ? [{ label: 'Outdoor', value: unit.outdoor }] : []),
  ...(unit.bedrooms ? [{ label: 'Bedrooms', value: String(unit.bedrooms) }] : []),
  { label: 'Sleeps', value: unit.sleeps },
  { label: 'Beds', value: unit.beds },
  { label: 'Children', value: childrenLabel(unit.slug) },
];
---

<BaseLayout title={unit.name} description={unit.description}>
  <section class="mx-auto max-w-[1320px] px-5 py-10 sm:px-10 lg:px-14">
    <a href={unit.building === 'farm' ? '/tourist-farm/' : '/traditional-house/'} class="text-sm font-semibold text-moss hover:text-moss-dark">← {unit.building === 'farm' ? 'Tourist farm rooms' : 'Traditional house units'}</a>
  </section>

  <section class="mx-auto max-w-[1320px] px-5 sm:px-10 lg:px-14">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow text-clay">{unit.group === 'apartments' ? 'Apartment' : unit.group === 'suites' ? 'Suite' : 'Room'}</p>
        <h1 class="font-display mt-5 text-5xl font-normal leading-[1.06] tracking-[-0.04em] text-ink lg:text-6xl">{unit.name}</h1>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class:list={['rounded-none px-3 py-1 text-sm font-semibold', unit.bathroom === 'Shared' ? 'bg-clay/15 text-clay-dark' : 'bg-moss/10 text-moss']}>
            {unit.bathroom} bathroom
          </span>
          {unit.outdoor && <span class="rounded-none bg-sand px-3 py-1 text-sm font-semibold text-ink">{unit.outdoor}</span>}
        </div>
        <p class="mt-6 text-lg text-ink/90">{unit.description}</p>
        {stay.searched ? <LivePrice quote={stay.quote} available={stay.available} /> : <>
          <p class="mt-5 text-2xl font-normal tracking-tight text-moss">{priceRange(unit.slug)}</p>
          <p class="mt-1 text-xs text-muted">Select dates and guests for live prices.</p>
        </>}
        <a
          id="unit-book-link"
          data-building={unit.building}
          data-slug={unit.slug}
          href="#booking"
          class="mt-8 inline-block rounded-none bg-moss px-6 py-3 font-semibold text-white transition-colors hover:bg-moss-dark"
        >
          Check dates & book →
        </a>
        <p id="unit-selection-note" class="mt-3 text-xs text-muted">Live availability and rates in the farm's booking system.</p>
      </div>
      <div class="self-start overflow-hidden">
        <Photo src={`/images/${unit.images[0]}`} alt={unit.name} class="aspect-[3/2] w-full object-cover" sizes="(min-width: 1320px) 584px, (min-width: 1024px) calc((100vw - 152px) / 2), (min-width: 640px) calc(100vw - 80px), calc(100vw - 40px)" loading="eager" />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1320px] px-5 py-12 sm:px-10 lg:px-14">
    <h2 class="font-display text-2xl font-normal tracking-tight text-ink">At a glance</h2>
    <dl class="mt-6 grid gap-px overflow-hidden rounded-none border border-line sm:grid-cols-2 lg:grid-cols-3">
      {facts.map((fact) => (
        <div class="bg-sand px-5 py-4">
          <dt class="text-xs uppercase tracking-wide text-muted">{fact.label}</dt>
          <dd class="mt-1 font-semibold text-ink">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  {unit.images.length > 1 && (
    <section class="mx-auto max-w-[1320px] px-5 pb-16 sm:px-10 lg:px-14">
      <h2 class="font-display text-2xl font-normal tracking-tight text-ink">Photos</h2>
      <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3">
        {unit.images.slice(1).map((image, index) => (
          <Photo
            src={`/images/${image}`}
            alt={`${unit.name} — photo ${index + 2}`}
            class="aspect-[3/2] w-full rounded-none object-cover"
            sizes="(min-width: 1320px) 395px, (min-width: 1024px) calc((100vw - 136px) / 3), (min-width: 768px) calc((100vw - 104px) / 3), (min-width: 640px) calc((100vw - 92px) / 2), calc((100vw - 52px) / 2)"
            loading="lazy"
          />
        ))}
      </div>
    </section>
  )}

  <UnitBooking stay={stay} building={unit.building} unitId={unit.bentral.unit} name={unit.name} />
</BaseLayout>
