---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact & booking" description="Contact Pr' Trlej and check availability.">
  <PageHero eyebrow="Contact" title="Come and stay" lead="Choose the traditional house, tourist farm or camping, or write to the family for help." image="guesthouse-terrace.jpg" alt="The sunny terrace at the family guesthouse" />

  <section class="mx-auto max-w-[1320px] px-5 py-16 sm:px-10 lg:px-14">
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="font-display text-4xl font-normal tracking-tight text-ink">Get in touch</h2>
        <ul class="mt-6 space-y-4 text-ink">
          <li>
            <p class="text-xs uppercase tracking-wide text-muted">Phone</p>
            <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="text-lg font-semibold text-moss hover:text-moss-dark">{site.phone}</a>
          </li>
          <li>
            <p class="text-xs uppercase tracking-wide text-muted">Email</p>
            <a href={`mailto:${site.email}`} class="text-lg font-semibold text-moss hover:text-moss-dark">{site.email}</a>
          </li>
          <li>
            <p class="text-xs uppercase tracking-wide text-muted">Address</p>
            <p class="text-ink">{site.address}, {site.city}, {site.country}</p>
          </li>
        </ul>
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.name}, ${site.address}, ${site.city}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-block text-sm font-semibold text-moss hover:text-moss-dark"
        >
          View on the map ↗
        </a>
      </div>

      <div class="rounded-none bg-moss p-8 text-cream">
        <h2 class="font-display text-2xl font-normal tracking-tight">Booking</h2>
        <p class="mt-3 text-cream/95">
          House rooms, farm rooms and camping each have their own booking form.
        </p>
        <div class="mt-6 space-y-3">
          <a href="/accommodation/?building=guesthouse" class="block rounded-none bg-moss px-6 py-3 text-center font-semibold text-white hover:bg-moss-dark">Book the traditional house →</a>
          <a href="/accommodation/?building=farm" class="block rounded-none border border-cream/40 px-6 py-3 text-center font-semibold text-cream hover:bg-white/10">Book the tourist farm →</a>
          <a href="/accommodation/?building=camping" class="block rounded-none border border-cream/40 px-6 py-3 text-center font-semibold text-cream hover:bg-white/10">Book camping →</a>
          <a href={site.facebookUrl} target="_blank" rel="noopener noreferrer" class="block rounded-none border border-cream/40 px-6 py-3 text-center font-semibold text-cream transition-colors hover:bg-white/10">
            Message us on Facebook ↗
          </a>
        </div>
        <p class="mt-6 text-xs text-cream/95">The farm's own website is {site.website}.</p>
      </div>
    </div>
  </section>
</BaseLayout>
